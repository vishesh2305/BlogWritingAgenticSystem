# Copy to .env and fill in. Never commit .env.

# Required
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# Recommended: production embeddings. Without it an offline hashing embedder is used.
VOYAGE_API_KEY=

# Optional: grammar auto-correction. `docker compose -f infra/docker-compose.yml up languagetool`
LANGUAGETOOL_URL=http://localhost:8010

# Optional overrides (defaults shown)
# MODEL_OPUS=claude-opus-5-5
# MODEL_SONNET=claude-sonnet-5-5
# MODEL_HAIKU=claude-haiku-5-5
# MAX_SEARCH_QUERIES=4
# MAX_SOURCES=12
# RETRIEVAL_K=12
