# Copy to .env and adjust. Never commit .env.
# With the defaults below the system runs completely free: local Ollama + DuckDuckGo search.

# --- LLM ---------------------------------------------------------------
LLM_PROVIDER=ollama                     # ollama (free, local) | gemini (fast, hosted) | anthropic
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-vl:8b-instruct       # any model from `ollama list`
OLLAMA_NUM_CTX=16384                    # context window; lower it if you run out of VRAM
# ANTHROPIC_API_KEY=                    # only when LLM_PROVIDER=anthropic

# Fast hosted models: LLM_PROVIDER=gemini. Groq takes over any call Gemini fails.
# GEMINI_API_KEY=                       # required for LLM_PROVIDER=gemini
# GROQ_API_KEY=                         # optional fallback; without it Gemini runs alone
# GEMINI_MODEL_OPUS=gemini-3.8-flash    # also _SONNET; _HAIKU defaults to gemini-3.5-flash-lite
# GROQ_MODEL_OPUS=openai/gpt-oss-120b   # also _SONNET; _HAIKU defaults to openai/gpt-oss-20b

# --- Optional paid services (free fallbacks are used when empty) --------
# TAVILY_API_KEY=                       # better search; fallback: DuckDuckGo
# VOYAGE_API_KEY=                       # better embeddings; fallback: local hashing embedder

# --- Optional grammar auto-correction ----------------------------------
# docker compose -f infra/docker-compose.yml up -d languagetool
# LANGUAGETOOL_URL=http://localhost:8010

# --- Tuning (defaults shown) -------------------------------------------
# MAX_SEARCH_QUERIES=4
# MAX_SOURCES=12
# RETRIEVAL_K=12
# AI_SCORE_THRESHOLD=10                 # Humanizer rewrites until the AI-likeness score is below this
# MAX_HUMANIZE_ROUNDS=2
